{
  "name": "bot",
  "version": "1.0.0",
  "description": "A complete, high-fidelity recreation of [botyk.app](https://botyk.app/) — the viral iMessage and WhatsApp conversation video generator with ElevenLabs TTS, realistic bubble rendering, gameplay backgrounds, and vertical 9:16 export.",
  "main": "assets/thought-line.js",
  "scripts": {
    "dev": "node dev.js",
    "start": "node dev.js --no-reload",
    "build": "npm run build:thought-line",
    "build:thought-line": "esbuild components/mountThoughtLine.jsx --bundle --minify --outfile=assets/thought-line.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "watch:thought-line": "esbuild components/mountThoughtLine.jsx --bundle --watch --outfile=assets/thought-line.js",
    "test": "node dev.js test"
  },
