+def get_apple_emoji(char, size):
+    cache_key = (char, int(size))
+    if cache_key in _EMOJI_CACHE:
+        return _EMOJI_CACHE[cache_key]
+
+    emojis_dir = os.path.join(ROOT_DIR, 'data', 'emojis')
+    os.makedirs(emojis_dir, exist_ok=True)
+
+    hex_code = '-'.join(f'{ord(c):x}' for c in char)
+    path = os.path.join(emojis_dir, f'{hex_code}.png')
+    if not os.path.exists(path):
+        hex_code_simple = '-'.join(f'{ord(c):x}' for c in char if ord(c) != 0xfe0f)
+        path = os.path.join(emojis_dir, f'{hex_code_simple}.png')
+
+    if not os.path.exists(path):
+        for code_variant in [hex_code, hex_code_simple]:
+            url = f"https://raw.githubusercontent.com/iamcal/emoji-data/master/img-apple-64/{code_variant}.png"
+            try:
+                import urllib.request
+                urllib.request.urlretrieve(url, path)
+                if os.path.exists(path) and os.path.getsize(path) > 100:
+                    break
+            except Exception:
+                pass
+
+    if os.path.exists(path) and os.path.getsize(path) > 100:
+        try:
+            im = Image.open(path).convert('RGBA')
+            resized = im.resize((int(size), int(size)), Image.Resampling.LANCZOS)
+            _EMOJI_CACHE[cache_key] = resized
+            return resized
+        except Exception:
+            pass
+
+    return None
