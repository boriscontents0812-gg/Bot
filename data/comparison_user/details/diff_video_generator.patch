+def compute_page_cuts(page_img, expected_msg_count, is_dark=False, show_header=True):
+    """
+    Analyzes a rendered/saved screenshot page image to locate the exact vertical cut lines
+    between each message bubble. This allows progressive reveal of DMs using 100% of the
+    authentic pixels from the saved screenshot image without re-rendering fonts or emojis.
+    Hugs each message with 20px bottom padding, matching iOS dynamic card expansion.
+    """
+    w, h = page_img.size
+    pixels = page_img.load()
+    bg_col = pixels[0, 0]
+
+    card_top = 0
+    card_bottom = h - 1
+    # Find card top and bottom along w // 2
+    for y in range(h):
+        p = pixels[w // 2, y]
+        if abs(p[0] - bg_col[0]) > 25 or abs(p[1] - bg_col[1]) > 25 or abs(p[2] - bg_col[2]) > 25:
+            card_top = y
+            break
+    for y in range(h - 1, card_top, -1):
+        p = pixels[w // 2, y]
+        if abs(p[0] - bg_col[0]) > 25 or abs(p[1] - bg_col[1]) > 25 or abs(p[2] - bg_col[2]) > 25:
+            card_bottom = y
+            break
+
+    # Find card_left and card_right at y = card_top + 30
+    check_y = min(card_top + 30, card_bottom)
+    card_left = 0
+    card_right = w - 1
+    for x in range(w):
+        p = pixels[x, check_y]
+        if abs(p[0] - bg_col[0]) > 25 or abs(p[1] - bg_col[1]) > 25 or abs(p[2] - bg_col[2]) > 25:
+            card_left = x
+            break
+    for x in range(w - 1, card_left, -1):
+        p = pixels[x, check_y]
+        if abs(p[0] - bg_col[0]) > 25 or abs(p[1] - bg_col[1]) > 25 or abs(p[2] - bg_col[2]) > 25:
+            card_right = x
+            break
+
+    header_offset = int(185 * (w / 1080.0)) if show_header else int(10 * (w / 1080.0))
+    msg_start_y = card_top + header_offset
+
+    row_has_bubble = []
+    for y in range(msg_start_y, card_bottom - 2):
+        has_b = False
+        for x in range(card_left + 18, card_right - 18, 4):
+            p = pixels[x, y]
+            if is_dark:
+                if p[0] > 20 or p[1] > 20 or p[2] > 20:
+                    has_b = True
+                    break
+            else:
+                if p[0] < 248 or p[1] < 248 or p[2] < 248:
+                    has_b = True
+                    break
+        row_has_bubble.append((y, has_b))
+
+    raw_bubbles = []
+    in_b = False
+    start_y = 0
+    for y, has_b in row_has_bubble:
+        if has_b and not in_b:
+            in_b = True
+            start_y = y
+        elif not has_b and in_b:
+            in_b = False
+            if (y - start_y) >= 15:
+                raw_bubbles.append((start_y, y - 1))
+    if in_b and (card_bottom - start_y) >= 15:
+        raw_bubbles.append((start_y, card_bottom))
+
+    bottom_pad = int(20 * (w / 1080.0))
+    if len(raw_bubbles) == expected_msg_count:
+        cuts = [min(card_bottom + 1, raw_bubbles[j][1] + bottom_pad) for j in range(expected_msg_count)]
+        return cuts
+
+    # Fallback if detection merged or split: interpolate proportionally
+    cuts = []
+    total_chat_h = card_bottom - msg_start_y
+    step = total_chat_h / max(1, expected_msg_count)
+    for j in range(expected_msg_count):
+        cuts.append(min(card_bottom + 1, int(msg_start_y + (j + 1) * step)))
+    return cuts
+
